+import { iamClient } from "@app-kit/lib/http";
+import type { UserNameFields } from "@app-kit/utils/user-display-name";
+
+type CreatorResponse = UserNameFields | { data: UserNameFields | null } | null;
+
+/** Read the creator's Console profile using the IAM host and Console tenant, not the environment. */
+export async function getProjectCreator(
+  userId: string,
+  consoleTenantId: string,
+): Promise<UserNameFields | null> {
+  const response = await iamClient.get<CreatorResponse>(
+    `/api/iam/users/${encodeURIComponent(userId)}`,
+    { "X-Blocks-Key": consoleTenantId },
+    { withCredentials: true },
+  );
+  // This card needs a name only; do not require organization/role fields to render a profile.
+  return response && "data" in response ? response.data : response;
+}
