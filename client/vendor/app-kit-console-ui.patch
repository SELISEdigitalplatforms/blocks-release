+import { SearchField } from "@app-kit/components/common/filter-toolbar/search-field";
+import { useRef, MouseEvent, useState, useEffect, useMemo } from "react";
+import { X } from "lucide-react-v1";
+import { Button } from "@app-kit/components/core/button";
+import { Input } from "@app-kit/components/core/input";
+import { cn } from "@app-kit/lib/utils";
+import { debounce } from "@app-kit/utils/functions";
+export interface SearchInputProps {
+  onChange: (value: string) => void;
+  placeholder?: string;
+  value: string;
+  className?: string;
+  containerClassName?: string;
+  ariaLabel?: string;
+  disabled?: boolean;
+  debounceMs?: number;
+  type?: "text" | "search";
+}
+export const SearchInput: React.FC<SearchInputProps> = ({
+  onChange,
+  placeholder = "Search...",
+  value,
+  className = "",
+  containerClassName,
+  ariaLabel,
+  disabled = false,
+  debounceMs = 300,
+  type = "text",
+}) => {
+  const [state, setState] = useState(value);
+  const [prevValue, setPrevValue] = useState(value);
+  if (prevValue !== value) {
+    setPrevValue(value);
+    setState(value);
+  }
+  const inputRef = useRef<HTMLInputElement>(null);
+  // The debounced wrapper must stay stable for the whole lifetime, but callers pass a new
+  // inline onChange every render. Route through a ref refreshed on each render so the
+  // debounced call always reaches the latest prop instead of the first render's closure.
+  const onChangeRef = useRef(onChange);
+  useEffect(() => {
+    onChangeRef.current = onChange;
+  });
+  // debounce stores this callback for a timer; it never reads the ref during render.
+  const debounced = useMemo(
+    // eslint-disable-next-line react-hooks/refs
+    () => debounce((val: string) => onChangeRef.current(val), debounceMs),
+    [debounceMs],
+  );
+  useEffect(() => {
+    return () => {
+      debounced.cancel();
+    };
+  }, [debounced]);
+  const handleChange = (event: React.ChangeEvent<HTMLInputElement>) => {
+    event.stopPropagation();
+    setState(event.target.value);
+    if (debounceMs === 0) onChange(event.target.value);
+    else debounced(event.target.value);
+  };
+  const handleClear = (e: MouseEvent) => {
+    e.stopPropagation();
+    debounced.cancel();
+    setState("");
+    onChange("");
+    inputRef.current?.focus();
+  };
+  return (
+    <SearchField
+      value={state}
+      label={ariaLabel ?? placeholder.replace(/\.\.\.$/, "")}
+      disabled={disabled}
+      className={containerClassName}
+    >
+      <div className="flex h-9 w-full min-w-0 items-center rounded-sm border border-border-default bg-card px-3 shadow-sm transition-colors focus-within:border-primary/60 focus-within:ring-2 focus-within:ring-primary/10">
+        <Input
+          ref={inputRef}
+          type={type}
+          disabled={disabled}
+          placeholder={placeholder}
+          aria-label={ariaLabel ?? placeholder.replace(/\.\.\.$/, "")}
+          value={state}
+          onChange={handleChange}
+          className={cn(
+            "h-full min-w-0 w-52 border-none bg-transparent p-0 text-[13px] focus-visible:ring-0 focus-visible:ring-offset-0",
+            className,
+            "h-full",
+          )}
+        />
+        <Button
+          variant="ghost"
+          size="xs"
+          className={cn("h-6 w-6 shrink-0 rounded-sm p-1", !state && "invisible")}
+          aria-label="Clear search"
+          disabled={disabled}
+          type="button"
+          onClick={handleClear}
+        >
+          <X className="h-4 w-4 text-muted-foreground" />
+        </Button>
+      </div>
+    </SearchField>
+  );
+};
