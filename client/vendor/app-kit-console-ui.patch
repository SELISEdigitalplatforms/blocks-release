+import { GitBranch } from "lucide-react-v1";
+import { Skeleton } from "@app-kit/components/core/skeleton";
+import type { IProject } from "@app-kit/models/project.model";
+import { getRuntimeEnv } from "@app-kit/lib/runtime-env";
+import { getProjectCreator } from "@app-kit/services/project-creator.service";
+import { useImpersonateStore } from "@app-kit/store";
+import { useAuthStore, useUserStore } from "@app-kit/store";
+import { useQuery } from "@tanstack/react-query";
+import { getUserDisplayName } from "@app-kit/utils/user-display-name";
+
+type ProjectMetadataProps = Pick<
+  IProject,
+  "environment" | "createdBy" | "createdDate" | "lastUpdatedDate"
+>;
+
+export const ProjectMetadata = ({
+  environment,
+  createdBy,
+  createdDate,
+  lastUpdatedDate,
+}: ProjectMetadataProps) => {
+  const { originalTenantId } = useImpersonateStore();
+  const { userDetails } = useUserStore();
+  const { user } = useAuthStore();
+  const normalizeUserId = (id?: string) => id?.replace(/^blocks\|/, "");
+  const profileMatches = Boolean(
+    createdBy &&
+    normalizeUserId(userDetails?.itemId || userDetails?.sub) === normalizeUserId(createdBy),
+  );
+  const signedInCreator = Boolean(
+    createdBy && normalizeUserId(user?.sub) === normalizeUserId(createdBy),
+  );
+  const profileName = profileMatches ? getUserDisplayName(userDetails) : "-";
+  const sessionName = signedInCreator ? user?.name?.trim() || getUserDisplayName(user) : "-";
+  const cachedName = profileName !== "-" ? profileName : sessionName;
+  const hasCachedName = cachedName !== "-";
+  const consoleTenantId = originalTenantId || getRuntimeEnv("BLOCKS_X_BLOCKS_KEY");
+  const { data: creator, isLoading } = useQuery({
+    queryKey: ["project-creator", consoleTenantId, createdBy],
+    queryFn: () => getProjectCreator(createdBy, consoleTenantId),
+    enabled: Boolean(createdBy && consoleTenantId && !hasCachedName),
+    retry: false,
+    staleTime: 5 * 60 * 1000,
+  });
+  const displayName = hasCachedName ? cachedName : getUserDisplayName(creator);
+  const creatorEmail = profileMatches
+    ? userDetails?.email
+    : signedInCreator
+      ? user?.email
+      : creator?.email;
+  const branchName = environment === "prod" ? "main" : environment;
+
+  return (
+    <dl className="grid w-full grid-cols-2 gap-x-5 gap-y-3 pt-3 sm:grid-cols-4 sm:gap-x-6">
+      <div className="min-w-0 space-y-1">
+        <dt className="text-xs text-muted-foreground">Branch Name</dt>
+        <dd className="flex items-center gap-1.5 font-mono text-sm font-medium text-high-emphasis">
+          <GitBranch className="h-3.5 w-3.5 shrink-0 text-muted-foreground" aria-hidden="true" />
+          <span className="break-all">{branchName || "—"}</span>
+        </dd>
+      </div>
+      <div className="min-w-0 space-y-1">
+        <dt className="text-xs text-muted-foreground">Created by</dt>
+        <dd className="text-sm font-medium text-high-emphasis">
+          {isLoading && !hasCachedName ? (
+            <Skeleton className="h-5 w-24 max-w-full" aria-label="Loading creator" />
+          ) : (
+            <span className="block break-words" title={creatorEmail || createdBy || undefined}>
+              {displayName === "-" ? "Unavailable" : displayName}
+            </span>
+          )}
+        </dd>
+      </div>
+      <div className="min-w-0 space-y-1">
+        <dt className="text-xs text-muted-foreground">Created</dt>
+        <dd>
+          <MetadataDate value={createdDate} />
+        </dd>
+      </div>
+      <div className="min-w-0 space-y-1">
+        <dt className="text-xs text-muted-foreground">Last updated</dt>
+        <dd>
+          <MetadataDate value={lastUpdatedDate} />
+        </dd>
+      </div>
+    </dl>
+  );
+};
+
+/** The same four cells, labels in place, while the project itself is still loading. */
+export const ProjectMetadataSkeleton = () => (
+  <dl className="grid w-full grid-cols-2 gap-x-5 gap-y-3 pt-3 sm:grid-cols-4 sm:gap-x-6">
+    {["Branch Name", "Created by", "Created", "Last updated"].map((label, index) => (
+      <div key={label} className="min-w-0 space-y-1">
+        <dt className="text-xs text-muted-foreground">{label}</dt>
+        <dd className="space-y-1">
+          <Skeleton className="h-5 w-24 max-w-full" />
+          {/* The two dates carry a second line, the time. */}
+          {index >= 2 && <Skeleton className="h-4 w-16 max-w-full" />}
+        </dd>
+      </div>
+    ))}
+  </dl>
+);
+
+const MetadataDate = ({ value }: { value?: string }) => {
+  const date = value ? new Date(value) : null;
+  if (!date || Number.isNaN(date.getTime())) {
+    return <span className="text-sm text-muted-foreground">—</span>;
+  }
+
+  return (
+    <time dateTime={value} title={date.toLocaleString()} className="block space-y-1">
+      <span className="block text-sm font-medium text-high-emphasis">
+        {date.toLocaleDateString(undefined, { month: "short", day: "numeric", year: "numeric" })}
+      </span>
+      <span className="block text-xs text-muted-foreground">
+        {date.toLocaleTimeString(undefined, {
+          hour: "numeric",
+          minute: "2-digit",
+          timeZoneName: "short",
+        })}
+      </span>
+    </time>
+  );
+};
