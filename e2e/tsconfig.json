{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "types": ["node"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": "./",
    "paths": {
      "@/tests": ["tests/*"],
      "@/support/*": ["support/*"],
      "@/pages/*": ["pages/*"],
      "@/constants/*": ["constants/*"],
      "@/fixtures/*": ["fixtures/*"]
    }
  },
  "include": ["**/*.ts"]
}
