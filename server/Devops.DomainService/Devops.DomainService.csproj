<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="KubernetesClient" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="SeliseBlocks.Genesis" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- Pin Swashbuckle to the supported version so the Swagger stack pulled transitively via
         SeliseBlocks.Genesis resolves to a Microsoft.OpenApi build without known advisories. -->
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

	<ItemGroup>
	    <Content Include="Assets\**\*.*">
		    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    </Content>
	</ItemGroup>

</Project>
