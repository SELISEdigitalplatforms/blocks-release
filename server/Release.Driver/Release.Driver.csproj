<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>4.0.2</Version>
    <PackageId>SeliseBlocks.ReleaseDriver.OS</PackageId>
    <Authors>SeliseBlocks</Authors>
    <Company>SeliseBlocks</Company>
    <Description>Blocks Release Driver</Description>
    <PackageReleaseNotes>Rebuilt against Genesis 4.2.2 for the three-connection database architecture. The bundled Devops.DomainService assembly was last published on 2026-08-13, before tenant placement landed, so it shipped without the routing work: BuildRepository no longer resolves an unused ambient collection in its constructor, GetHostingProviders reads HostingProviders from the root database it already resolved instead of the caller's tenant, and RepoRepository, BuildService, DeploymentTeardownService and PipelineRunService carry the explicit tenant overloads added for multi-database routing. No API removals; the Tenant-taking overloads on IRepoRepository and IBuildRepository are additive.</PackageReleaseNotes>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <IncludeOutputAssemblies>true</IncludeOutputAssemblies>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Genesis, BlocksGenesis, SeliseBlocksGenesis, Release, Deployment, Driver</PackageTags>
    <RepositoryUrl>https://github.com/SELISEdigitalplatforms/blocks-release</RepositoryUrl>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Transitive dependencies of Devops.DomainService bundled in this package -->
    <PackageReference Include="KubernetesClient" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="SeliseBlocks.Genesis.OS" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <ProjectReference Include="..\Devops.DomainService\Devops.DomainService.csproj" PrivateAssets="All" />
    <None Remove="bin\Release\net10.0\Devops.DomainService.dll" />
    <None Include="$(OutputPath)Devops.DomainService.dll" Pack="true" PackagePath="lib/net10.0/" />
  </ItemGroup>

</Project>
