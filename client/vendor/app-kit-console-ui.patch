+import { Button } from "@app-kit/components/core/button";
+import { useGetProject } from "@app-kit/hooks/use-project";
+import { Rocket } from "lucide-react-v1";
+import { useEffect, useState } from "react";
+import { motion, useAnimationControls, useReducedMotion } from "framer-motion";
+import { useLocation } from "react-router";
+import { OnboardDialog } from "./onboard-dialog";
+
+/**
+ * Opens the ready-to-paste onboarding brief for the selected project. Reads the
+ * project from the same cached query the overview page uses, so it costs no
+ * extra request and needs no props threaded through `ProjectActions`.
+ */
+export const OnboardProject = () => {
+  const [open, setOpen] = useState(false);
+  const { data } = useGetProject();
+  const reducedMotion = useReducedMotion();
+  const rocketControls = useAnimationControls();
+  const { pathname } = useLocation();
+
+  useEffect(() => {
+    if (reducedMotion) rocketControls.set("rest");
+    else void rocketControls.start("enter");
+  }, [rocketControls, reducedMotion, pathname, data?.data?.tenantId]);
+
+  useEffect(() => {
+    if (open && !reducedMotion) void rocketControls.start("launch");
+  }, [rocketControls, open, reducedMotion]);
+
+  return (
+    <>
+      <Button
+        variant="ghost"
+        size="sm"
+        className="flex h-9 items-center gap-2 rounded-md bg-card px-4 text-high-emphasis shadow-surface-ring hover:bg-surface-warm hover:shadow-raised"
+        onClick={() => setOpen(true)}
+        asChild
+      >
+        <motion.button
+          initial="rest"
+          animate={rocketControls}
+          whileHover={reducedMotion || open ? undefined : "hover"}
+          whileFocus={reducedMotion || open ? undefined : "hover"}
+          type="button"
+        >
+          <motion.span
+            className="inline-flex"
+            aria-hidden="true"
+            variants={{
+              rest: { x: 0, y: 0, rotate: 0, scale: 1, transition: { duration: 0.15 } },
+              enter: {
+                x: [0, -1, 1, -1, 6, 0],
+                y: [0, 1, -1, 1, -6, 0],
+                rotate: [0, -6, 6, -4, 0],
+                scale: [1, 1, 1, 0.95, 1.1, 1],
+                transition: { duration: 0.85, delay: 0.12 },
+              },
+              hover: {
+                x: [0, -1, 1, -1, 2, 0],
+                y: [0, 1, -1, 1, -3, 0],
+                rotate: [0, -6, 6, -4, 0],
+                transition: { duration: 0.8, repeat: Infinity, repeatDelay: 1.1 },
+              },
+              launch: {
+                x: [0, -1, 6, 0],
+                y: [0, 1, -6, 0],
+                rotate: [0, -5, 0, 0],
+                scale: [1, 0.95, 1.1, 1],
+                transition: { duration: 0.4 },
+              },
+            }}
+          >
+            <Rocket className="h-4 w-4" />
+          </motion.span>
+          <span>Bootstrap</span>
+        </motion.button>
+      </Button>
+      <OnboardDialog open={open} onOpenChange={setOpen} project={data?.data} />
+    </>
+  );
+};
