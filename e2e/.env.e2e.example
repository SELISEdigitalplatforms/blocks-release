# Copy this file to `.env.e2e` (gitignored) and fill in real values.

# Base URL of the Blocks Release app under test.
#
# Remote dev (default, no local server needed):
#   E2E_BASE_URL=https://dev-release.blocksdeveloper
#
# Local build served by the .NET host on API_PORT (see run.sh): point the
# domain at your machine with a hosts entry, e.g.
#   127.0.0.1 dev-release.blocksdeveloper
# then use https://dev-release.blocksdeveloper:5000
E2E_BASE_URL=https://dev-release.blocksdevelopers.com

# Base URL of the Blocks OS app
E2E_OS_BASE_URL=https://dev-os.blocksdevelopers.com

# Dev-IAM test account credentials (captcha is disabled on dev).
E2E_USERNAME=
E2E_PASSWORD=

# Set to 1 to skip auto-starting the app (you manage the server yourself, or
# you are testing a remote host). Required when E2E_BASE_URL is the remote dev
# server — otherwise Playwright boots a local API via `run.sh -b` and waits on
# a URL it will never own.
E2E_NO_WEBSERVER=1

# Pause after each test so the end state is watchable. Defaults to 10000 in
# headed mode and 0 when headless; set a value to override either way.
# E2E_PAUSE_MS=10000

# Milliseconds of delay per action, to watch the steps themselves.
# E2E_SLOWMO=600
