+import React from "react";
+import { Link, useLocation } from "react-router";
+import { Home } from "lucide-react-v1";
+import { Logo } from "@app-kit/components";
+import { useLogo } from "@app-kit/hooks";
+import { cn } from "@app-kit/lib/utils";
+import type { PaletteNavSection as NavSection } from "@app-kit/components/common/command-palette";
+import { useBreadcrumbTrail } from "./breadcrumb-titles-context";
+
+/**
+ * The top bar's trail: home / group / current page.
+ *
+ * Derived from the navigation model rather than from path segments. The URL
+ * carries an opaque project id (`/app/<itemId>/iam/user-detail/7`), so a
+ * segment-derived trail reads "App / 019ab… / Iam / Users / 7" — which is why
+ * every in-page breadcrumb had to slice it with a hard-coded `breadcrumbIndex`.
+ * Reading the active menu instead gives the group and page names directly, and
+ * pages append their own dynamic crumbs through `useSetBreadcrumbTrail`.
+ */
+export function TopbarBreadcrumbs({
+  sections,
+  className,
+}: {
+  sections: NavSection[];
+  className?: string;
+}) {
+  const { pathname } = useLocation();
+  const appended = useBreadcrumbTrail();
+  const { appLightLogo, appDarkLogo } = useLogo();
+  const isConsoleShell = sections.length === 0;
+
+  const active = React.useMemo(() => {
+    let best: { section: NavSection; label: string; href: string } | null = null;
+    for (const section of sections) {
+      for (const item of section.items) {
+        if (pathname !== item.path && !pathname.startsWith(`${item.path}/`)) continue;
+        // Longest match wins, so a nested path beats its parent prefix.
+        if (!best || item.path.length > best.href.length) {
+          best = { section, label: item.name, href: item.path };
+        }
+      }
+    }
+    return best;
+  }, [sections, pathname]);
+
+  const crumbs: { label: string; href?: string; key: string }[] = [];
+  if (active?.section.label) {
+    crumbs.push({ label: active.section.label, key: `group:${active.section.id}` });
+  }
+  if (active) {
+    crumbs.push({ label: active.label, href: active.href, key: `item:${active.href}` });
+  }
+  appended.forEach((crumb, index) =>
+    crumbs.push({ ...crumb, key: `extra:${index}:${crumb.label}` }),
+  );
+
+  return (
+    <nav
+      aria-label="Breadcrumb"
+      className={cn(
+        "flex min-w-0 items-center gap-3 text-[13px] text-muted-foreground",
+        className,
+      )}
+    >
+      {/* The home icon and its separator are the first things to go on mobile.
+          On the console shell, the Blocks OS wordmark replaces the home icon. */}
+      <Link
+        to="/app/console"
+        aria-label={isConsoleShell ? "Console" : "Home"}
+        className={cn("shrink-0 transition-colors hover:text-high-emphasis", !isConsoleShell && "hidden md:inline-flex")}
+      >
+        {isConsoleShell ? (
+          <Logo
+            lightSrc={appLightLogo}
+            darkSrc={appDarkLogo}
+            alt="Console"
+            className="h-6 w-auto"
+          />
+        ) : (
+          <Home aria-hidden="true" className="h-3.5 w-3.5" />
+        )}
+      </Link>
+      {crumbs.length > 0 ? (
+        <span aria-hidden="true" className="hidden text-low-emphasis md:inline">
+          /
+        </span>
+      ) : null}
+
+      {crumbs.map((crumb, index) => {
+        const isLast = index === crumbs.length - 1;
+        return (
+          <React.Fragment key={crumb.key}>
+            {isLast ? (
+              <span
+                aria-current="page"
+                className="truncate font-medium text-high-emphasis"
+              >
+                {crumb.label}
+              </span>
+            ) : (
+              <>
+                {crumb.href ? (
+                  <Link
+                    to={crumb.href}
+                    className="hidden shrink-0 transition-colors hover:text-high-emphasis sm:inline"
+                  >
+                    {crumb.label}
+                  </Link>
+                ) : (
+                  <span className="hidden shrink-0 sm:inline">{crumb.label}</span>
+                )}
+                <span
+                  aria-hidden="true"
+                  className="hidden text-low-emphasis sm:inline"
+                >
+                  /
+                </span>
+              </>
+            )}
+          </React.Fragment>
+        );
+      })}
+    </nav>
+  );
+}
