<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>4.0.4</Version>
    <PackageId>SeliseBlocks.ReleaseDriver.OS</PackageId>
    <Authors>SeliseBlocks</Authors>
    <Company>SeliseBlocks</Company>
    <Description>Blocks Release Driver</Description>
    <PackageReleaseNotes>GitHub access tokens are stored in Azure Key Vault through the Blocks.Secrets value store; the RepositoryTokens row keeps only TokenSecretId. Rows with a plaintext AccessToken stay readable and move to the vault on the user's next connect, so no data migration is needed. The host must resolve ISecretValueStore to the Key Vault store (KeyVault__KeyVaultUrl set, Secrets__ValueStore unset or KeyVault): with the database store, connecting, revoking and building webhooks fail with a token-store error, while legacy plaintext tokens keep working. RegisterBlocksReleaseServicesAsync calls AddBlocksSecrets(), whose registrations are TryAdd, so a host's own call made first is kept. The package now declares its SeliseBlocks.Secrets.OS dependency, which 4.0.3 bundled an assembly reference to without declaring. No API removals.</PackageReleaseNotes>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <IncludeOutputAssemblies>true</IncludeOutputAssemblies>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Genesis, BlocksGenesis, SeliseBlocksGenesis, Release, Deployment, Driver</PackageTags>
    <RepositoryUrl>https://github.com/SELISEdigitalplatforms/blocks-release</RepositoryUrl>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Transitive dependencies of Devops.DomainService bundled in this package -->
    <PackageReference Include="KubernetesClient" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="SeliseBlocks.Genesis.OS" />
    <PackageReference Include="SeliseBlocks.Secrets.OS" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <ProjectReference Include="..\Devops.DomainService\Devops.DomainService.csproj" PrivateAssets="All" />
    <None Remove="bin\Release\net10.0\Devops.DomainService.dll" />
    <None Include="$(OutputPath)Devops.DomainService.dll" Pack="true" PackagePath="lib/net10.0/" />
  </ItemGroup>

</Project>
