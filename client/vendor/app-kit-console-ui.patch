+import {
+  createContext,
+  useCallback,
+  useContext,
+  useEffect,
+  useMemo,
+  useState,
+  type ReactNode,
+} from "react";
+
+/** A crumb a page appends after the active nav item (e.g. the record's name). */
+export type TrailCrumb = { label: string; href?: string };
+
+type BreadcrumbTrailContextValue = {
+  trail: TrailCrumb[];
+  publish: (key: string, crumbs: TrailCrumb[]) => void;
+  retract: (key: string) => void;
+};
+
+const BreadcrumbTrailContext =
+  createContext<BreadcrumbTrailContextValue | null>(null);
+
+/**
+ * Lets a page append dynamic crumbs — a user's name, a role, a trace id — to the
+ * trail the top bar derives from the navigation model. Entries are keyed per
+ * publisher so an unmounting page withdraws only its own.
+ */
+export function BreadcrumbTrailProvider({ children }: { children: ReactNode }) {
+  const [entries, setEntries] = useState<Record<string, TrailCrumb[]>>({});
+
+  const publish = useCallback((key: string, crumbs: TrailCrumb[]) => {
+    setEntries((prev) => ({ ...prev, [key]: crumbs }));
+  }, []);
+
+  const retract = useCallback((key: string) => {
+    setEntries((prev) => {
+      if (!(key in prev)) return prev;
+      const next = { ...prev };
+      delete next[key];
+      return next;
+    });
+  }, []);
+
+  const value = useMemo(
+    () => ({ trail: Object.values(entries).flat(), publish, retract }),
+    [entries, publish, retract],
+  );
+
+  return (
+    <BreadcrumbTrailContext.Provider value={value}>
+      {children}
+    </BreadcrumbTrailContext.Provider>
+  );
+}
+
+/** Read the appended crumbs. Returns `[]` outside a provider. */
+export function useBreadcrumbTrail(): TrailCrumb[] {
+  return useContext(BreadcrumbTrailContext)?.trail ?? [];
+}
+
+/**
+ * Append crumbs for the current page.
+ *
+ * Safe to call outside a provider, so a page can adopt it without caring which
+ * shell renders it. Pass `[]` while data is still loading.
+ */
+export function useSetBreadcrumbTrail(key: string, crumbs: TrailCrumb[]): void {
+  const context = useContext(BreadcrumbTrailContext);
+  const publish = context?.publish;
+  const retract = context?.retract;
+  // Callers pass an array literal, so compare by value rather than identity.
+  const serialized = JSON.stringify(crumbs);
+
+  useEffect(() => {
+    if (!publish || !retract) return;
+    publish(key, JSON.parse(serialized) as TrailCrumb[]);
+    return () => retract(key);
+  }, [key, serialized, publish, retract]);
+}
