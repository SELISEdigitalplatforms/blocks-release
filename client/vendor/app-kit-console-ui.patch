+import type { ReactNode } from "react";
+import { Skeleton } from "@app-kit/components/core/skeleton";
+import { SearchInput } from "./dashboard-search-input";
+import { Pagination } from "./dashboard-pagination";
+import { DASHBOARD_TABLE_PAGE_SIZE } from "./dashboard.constant";
+
+export function DashboardTableSection({
+  title,
+  description,
+  tools,
+  children,
+}: {
+  title: string;
+  description: string;
+  tools?: ReactNode;
+  children: ReactNode;
+}) {
+  return (
+    <section aria-label={title} className="min-w-0 space-y-2">
+      <header className="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
+        <div className="flex min-w-0 flex-wrap items-baseline gap-x-2.5 gap-y-1">
+          <h2 className="text-[13px] font-bold uppercase tracking-[0.06em] text-high-emphasis">
+            {title}
+          </h2>
+          <p className="text-[13px] text-muted-foreground">{description}</p>
+        </div>
+        {tools && (
+          <div className="ml-auto flex max-w-full flex-wrap items-center justify-end gap-2 lg:shrink-0">
+            {tools}
+          </div>
+        )}
+      </header>
+      <div className="overflow-hidden rounded-sm bg-card shadow-surface-ring">{children}</div>
+    </section>
+  );
+}
+
+/** Placeholder rows for a section's table body: an icon, a name, and a trailing value. */
+export function DashboardTableSkeleton({ label, rows = 5 }: { label: string; rows?: number }) {
+  return (
+    <div aria-label={label} className="border-t border-border/60">
+      {Array.from({ length: rows }).map((_item, index) => (
+        <div
+          key={index}
+          className="flex items-center gap-4 border-b border-border/50 px-5 py-4 last:border-0"
+        >
+          <Skeleton className="h-8 w-8 shrink-0 rounded-sm" />
+          <Skeleton className="h-4 w-1/4" />
+          <Skeleton className="ml-auto h-4 w-1/3" />
+        </div>
+      ))}
+    </div>
+  );
+}
+
+export function DashboardTableSearch({
+  value,
+  onChange,
+  placeholder,
+}: {
+  value: string;
+  onChange: (value: string) => void;
+  placeholder: string;
+}) {
+  return (
+    <SearchInput
+      value={value}
+      onChange={onChange}
+      placeholder={placeholder}
+      type="search"
+      debounceMs={0}
+      containerClassName="sm:w-64"
+      className="w-full [&::-webkit-search-cancel-button]:appearance-none"
+    />
+  );
+}
+
+export function DashboardTablePagination({
+  label,
+  page,
+  totalCount,
+  onPageChange,
+}: {
+  label: string;
+  page: number;
+  totalCount: number;
+  onPageChange: (page: number) => void;
+}) {
+  if (totalCount === 0) return null;
+  return (
+    <nav
+      aria-label={`${label} pagination`}
+      className="flex flex-wrap items-center justify-between gap-3 border-t border-border/60 px-5 py-3"
+    >
+      <p className="text-xs tabular-nums text-muted-foreground">
+        Showing {page * DASHBOARD_TABLE_PAGE_SIZE + 1}–
+        {Math.min((page + 1) * DASHBOARD_TABLE_PAGE_SIZE, totalCount)} of {totalCount}
+      </p>
+      <Pagination
+        compact
+        page={page}
+        pageSize={DASHBOARD_TABLE_PAGE_SIZE}
+        totalCount={totalCount}
+        onChange={onPageChange}
+      />
+    </nav>
+  );
+}
