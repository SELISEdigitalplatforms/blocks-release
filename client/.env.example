# Exposed via `envPrefix: ['BLOCKS_']` in vite.config (access via `import.meta.env.BLOCKS_*`).
# Copy to `.env` and set values. Restart `npm run dev` after changes.
BLOCKS_APP_URL=
BLOCKS_API_BASE_URL=
BLOCKS_X_BLOCKS_KEY=
BLOCKS_GOOGLE_SITE_KEY=
BLOCKS_CONSTRUCT_URL=
BLOCKS_GITHUB_SSO_CLIENT_ID=
BLOCKS_LOGIC_APP_URL=
BLOCKS_IDP_BASE_URL =
BLOCKS_OS_URL=
BLOCKS_OIDC_CLIENT_ID =
BLOCKS_DEV_HOST=
# Local HTTPS is NOT configured here. It is driven by two MACHINE (OS user) env vars:
#   RELEASE_SSL_CERT  -> absolute path to the mkcert cert PEM
#   RELEASE_SSL_KEY   -> absolute path to the mkcert private-key PEM
# Both set + both files present -> FE on https://<BLOCKS_DEV_HOST>:4000.
# Either missing -> automatic HTTP fallback. See LOCAL_GUIDE.md "Local HTTPS setup (mkcert)".
