# Copy this file to `.env.e2e` (gitignored) and fill in real values.

# Base URL of the Blocks Release app under test.
#
# Remote dev (no local build needed) — also set E2E_NO_WEBSERVER=1 below:
#   E2E_BASE_URL=https://dev-release.blocksdevelopers.com
#
# Local build on :5000 — requires a hosts entry pointing the domain at
# 127.0.0.1, e.g.
#   127.0.0.1 dev-release.blocksdevelopers.com
E2E_BASE_URL=https://dev-release.blocksdevelopers.com

# Blocks OS host for project delete and repository linking.
# Defaults to dev-os when E2E_BASE_URL uses dev-release.
# E2E_OS_BASE_URL=https://dev-os.blocksdevelopers.com

# Dev-IAM test account credentials (captcha is disabled on dev).
E2E_USERNAME=
E2E_PASSWORD=

# Reuse an existing project instead of creating Test Project *.
# Recommended when your console is full — e.g. the "test" project in UAT.
E2E_REUSE_PROJECT_NAME=test

# Open project by UUID (/app/{id}/deployment). Skips console card search.
# E2E_PROJECT_ID=

# Set to 1 to never delete the shared project after a run.
# E2E_KEEP_PROJECT=1

# Set to 1 to skip auto-starting the app (remote dev CI).
# E2E_NO_WEBSERVER=1

# Pause after each test (headed debugging).
# E2E_PAUSE_MS=10000

# Milliseconds of delay per action.
# E2E_SLOWMO=600

# Comma-separated feature ids for npm run test:features (or "all").
# E2E_FEATURES=deployment
