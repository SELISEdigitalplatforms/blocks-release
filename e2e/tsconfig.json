{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,

    "paths": {
      "@/tests/*": ["./tests/*"],
      "@/support/*": ["./support/*"],
      "@/pages/*": ["./pages/*"],
      "@/constants/*": ["./constants/*"],
      "@/fixtures/*": ["./fixtures/*"]
    }
  },
  "include": ["**/*.ts"]
}
