{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "SwaggerOptions": {
    "Version": "v1",
    "Title": "Blocks Release API",
    "Description": "Blocks Release API documentation",
    "EnableBearerAuth": true,
    "EndpointUrl": "/swagger/v1/swagger.json",
    "XmlCommentsFilePath": "Blocks.Genesis.xml",
    "ServiceName": "release"
  },

  // CSP hosts come from FrontendRuntime, so they follow the environment automatically.
  // These are only the fixed third-party hosts (same set as blocks-monitor, plus the DM Sans
  // Google Fonts stylesheet/font hosts index.html loads). Space- or comma-separated; override
  // per environment via Csp__ExtraConnectSrc / Csp__ExtraImgSrc / Csp__ExtraStyleSrc / Csp__ExtraFontSrc.
  "Csp": {
    "ExtraConnectSrc": "https://api.rollbar.com https://code.selise.biz https://www.google.com https://www.gstatic.com https://blocksdev.blob.core.windows.net",
    "ExtraImgSrc": "https://az-cdn.selise.biz https://blocksdev.blob.core.windows.net",
    "ExtraStyleSrc": "https://fonts.googleapis.com",
    "ExtraFontSrc": "https://fonts.gstatic.com"
  }
}
